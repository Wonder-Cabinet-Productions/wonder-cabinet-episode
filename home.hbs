{{!< default}}

<main id="main-content" class="gh-main wc-main">
    {{!-- Brand band: one continuous artwork backdrop bleeds behind the (translucent) nav,
         the hero, and the podcast-services bar. See "Brand Band" in screen.css. --}}
    <div class="wc-brand-band">
        {{!-- Hero zone: galaxy bg via CSS background-image, extends behind wave divider + hero --}}
        <div class="wc-hero-zone">
            {{!-- Wave divider between navbar and hero (homepage only) --}}
            <div class="wc-wave-divider">
                <img src="{{asset "images/ui-wave-divider-light.svg"}}" alt="" aria-hidden="true">
            </div>

            {{> "components/home-hero"}}
        </div>

        {{!-- Green rule between hero and podcast services --}}
        <hr class="wc-rule wc-rule--thick">

        {{> "podcast-services"}}
    </div>

    {{!-- Green rule below podcast services (outside the band — separates band from archive) --}}
    <hr class="wc-rule">

    <section class="gh-archive gh-outer">
        <div class="gh-archive-inner gh-inner">
            <header class="gh-archive-header">
                <h1 class="gh-archive-title">{{#if @custom.episode_section_heading}}{{@custom.episode_section_heading}}{{else}}Latest Episodes{{/if}}</h1>
            </header>
        </div>
    </section>

    {{!-- The river (#100): every non-newsletter post, newest first, in its series' colours.
         Sticky slots (series/registry) sit after cards 2, 4 and 6 and show a series' newest
         featured post only when the river doesn't. The batch size (8) must match riverSize
         below and `limit: 8` on the /latest/ route in docs/routes.yaml. --}}
    <div class="gh-list simple gh-outer">
        <div class="gh-list-inner gh-inner">
            <div class="gh-list-feed" data-wc-river>
                {{#get "posts" include="tags,authors" filter="tag:-newsletter" limit="8"}}
                    {{#foreach posts}}
                        {{> components/list-item seriesBrand=true showExcerpt=true showPublishedAt=true}}

                        {{#match @index "==" 1}}{{> "series/registry" mode="slot" position=1 riverSize=8}}{{/match}}
                        {{#match @index "==" 3}}{{> "series/registry" mode="slot" position=2 riverSize=8}}{{/match}}
                        {{#match @index "==" 5}}{{> "series/registry" mode="slot" position=3 riverSize=8}}{{/match}}
                    {{/foreach}}
                {{/get}}
            </div>
        </div>
    </div>

    {{!-- Green rule after episodes --}}
    <hr class="wc-rule">

    {{> "components/cta" title=@custom.email_signup_text}}
</main>