{{!< default}}

{{!--
    Show About — a page type (Ghost Admin → page settings → Template → "Show About").

    Pick this template and tag the page with its show (e.g. `luminous`) to give that
    show's landing page an About modal; components/show-about finds the page by both.
    The show tag also brands this standalone page: default.hbs sets brand-<primary tag>.

    This standalone page is what the modal's link falls back to without JS, and what a
    new-tab click opens.
--}}

{{#post}}
<main id="main-content" class="gh-main wc-main">
    <header class="wc-page-header gh-outer">
        <div class="gh-inner">
            <h1 class="wc-page-title">{{title}}</h1>
        </div>
    </header>

    <section class="wc-page-content gh-outer">
        <div class="gh-inner">
            <article class="gh-article">
                <div class="gh-content">
                    {{content}}
                </div>
            </article>
        </div>
    </section>

    {{> "components/cta"}}
</main>
{{/post}}
