{{!< default}}

<main id="main-content" class="gh-main wc-main">
    {{!-- Brand band: wavy artwork bleeds behind the (translucent) nav, the hero, and the
         podcast-services bar. Mirrors home.hbs. See "Brand Band" in screen.css. --}}
    <div class="wc-brand-band">
        {{!-- Luminous hero zone: wavy bg via CSS (body.brand-luminous), mirrors the WC home hero-zone --}}
        <div class="wc-hero-zone">
            {{> "components/luminous-hero"}}
        </div>

        {{!-- Rule between hero and podcast services --}}
        <hr class="wc-rule wc-rule--thick">

        {{!-- Podcast services: Luminous description, its own listen links, its About modal.
             The row is components/show-services, shared with the homepage and tag landings. --}}
        {{> "components/show-services" blurbTag="luminous" apple=@custom.luminous_apple_podcasts_link spotify=@custom.luminous_spotify_link youtube=@custom.luminous_youtube_music_link aboutTag="luminous"}}
    </div>

    {{!-- Rule below podcast services (outside the band — separates band from archive) --}}
    <hr class="wc-rule">

    {{!-- Episode list without Wonder Cabinet cabinet-frame styling --}}
    <section class="gh-archive gh-outer">
        {{!-- Section header, matching home.hbs. Also gives this page its only h1 — it had
             none before, starting straight at h3 (#102). --}}
        <div class="gh-archive-inner gh-inner">
            <header class="gh-archive-header">
                <h1 class="gh-archive-title">{{#if @custom.episode_section_heading}}{{@custom.episode_section_heading}}{{else}}Latest Episodes{{/if}}</h1>
            </header>
        </div>
        <div class="gh-inner">
            {{> "components/list" layout="simple" showExcerpt=true showPublishedAt=true hasPagination=true}}
        </div>
    </section>

    {{!-- Rule after episodes — matches home.hbs's treatment between list and pagination (#102) --}}
    <hr class="wc-rule">

    {{> "components/pagination"}}

    {{!-- Pass the Ghost Admin setting through, as home.hbs does. Without it this page fell
         through to cta.hbs's hardcoded default, so copy edited in Admin never reached the
         Luminous landing page (#102). --}}
    {{> "components/cta" title=@custom.email_signup_text}}
</main>
