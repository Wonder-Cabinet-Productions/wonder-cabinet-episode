{{!--
    Wonder Cabinet Tag Archive Header
    Hero section with galaxy background for tag pages
    Supports optional feature_image for series artwork, which then replaces the text title.

    landing=true (components/tag-landing, #125): drop the hero's own galaxy, because the
    brand band behind it carries the backdrop, and drop the description, which moves into
    the services row below.
--}}

<section class="wc-tag-hero{{#if feature_image}} has-feature-image{{/if}}{{#if landing}} wc-tag-hero--landing{{/if}}">
    {{#unless landing}}
    <div class="wc-tag-hero-bg">
        <img src="{{asset "images/bg-galaxy-spiral-1200w-2x.webp"}}" alt="" class="wc-tag-hero-galaxy" aria-hidden="true">
    </div>
    {{/unless}}
    <div class="wc-tag-hero-content gh-inner">
        {{!-- The hero names the tag exactly once (#125). With art (usually a wordmark logo)
             the art is the h1 and its alt text carries the name; without art the name
             prints as text. Templates using this partial don't repeat the name above
             their list. --}}
        {{#if feature_image}}
            <h1 class="wc-tag-hero-image">
                <img src="{{img_url feature_image size="m"}}" alt="{{name}}">
            </h1>
        {{else}}
            <h1 class="wc-tag-hero-title">{{name}}</h1>
        {{/if}}
        {{#unless landing}}
        {{#if description}}
            <p class="wc-tag-hero-description">{{description}}</p>
        {{else}}
            {{!-- Show tags — a tag that fronts its own podcast feed — fall back to the
                 network blurb so a show page is never description-less. Ordinary tags stay
                 silent on purpose: printing the network's podcast blurb under, say,
                 "Island of Knowledge" would read as a mistake, not a fallback.

                 routes.yaml's `collections:` is the source of truth for what counts as a
                 show; keep this list in step when one is added.

                 Currently unreachable, deliberately kept: routes.yaml claims both show tags
                 for collections, so /tag/wonder-cabinet/ and /tag/luminous/ 301 to / and
                 /luminous/ and never render this template. This is insurance for a show
                 that has no collection, or for the routing changing. --}}
            {{#has slug="wonder-cabinet, luminous"}}
                <p class="wc-tag-hero-description">{{@site.description}}</p>
            {{/has}}
        {{/if}}
        {{/unless}}
    </div>
</section>
