{{!--
    Wonder Cabinet Highlight Card: a pinned ("sticky") post on the homepage (#100).
    Renders the CURRENT post; series/slot decides which post and whether it shows.

    Parameters:
    - badgeSlug:   series tag slug; the badge text is that tag's NAME (editable in Admin)
    - badgeUrl:    the series page, from series/registry (Ghost reports /404/ for tags a
                   collection owns, so {{url}} can't supply it)
    - accentClass: wc-highlight--newsletter | wc-highlight--series | wc-highlight--luminous

    CTA button text is data-driven: posts tagged "newsletter" get "Read", all others get "View Episode".
--}}

<article data-wc-slot="{{badgeSlug}}" data-post-id="{{id}}" class="gh-list-item wc-episode-card wc-highlight-zone {{accentClass}} {{post_class}}">
    <a class="wc-highlight-badge" href="{{badgeUrl}}">{{#foreach tags}}{{#match slug ../badgeSlug}}{{name}}{{/match}}{{/foreach}}</a>
    <a class="gh-list-item-inner wc-episode-card-inner wc-highlight-zone-inner" href="{{url}}">
        {{#if feature_image}}
            <figure class="gh-list-item-image wc-episode-card-image">
                <img
                    srcset="{{img_url feature_image size="s"}} 300w,
                            {{img_url feature_image size="m"}} 720w,
                            {{img_url feature_image size="l"}} 960w"
                    sizes="(max-width: 767px) 100vw, 229px"
                    src="{{img_url feature_image size="m"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                >
            </figure>
        {{/if}}
        <div class="gh-list-item-content wc-episode-card-content">
            <span class="gh-list-item-published-at wc-episode-card-date">{{date published_at format="DD MMM YYYY"}}</span>
            <h3 class="gh-list-item-title wc-episode-card-title">{{title}}</h3>
            <p class="gh-list-item-excerpt wc-episode-card-excerpt">{{excerpt}}</p>
            <span class="wc-episode-card-btn wc-highlight-zone-btn">
                {{#has tag="newsletter"}}
                    Read
                {{else}}
                    <img src="{{asset "images/play-white.svg"}}" alt="" class="wc-episode-card-btn-icon">
                    View Episode
                {{/has}}
            </span>
        </div>
    </a>
</article>
