{{!--
    Wonder Cabinet Audio Player Hero
    Green gradient card with galaxy background + service buttons inline
    Renders on ALL posts unconditionally
--}}

<section class="wc-audio-hero-wrapper">
    {{!-- Galaxy background via CSS ::before pseudo-element (matches home hero pattern) --}}

    {{!-- Green player card --}}
    <section class="wc-audio-hero" id="wc-audio-player">
        <div class="wc-audio-hero-inner gh-inner">
            {{!-- Episode artwork --}}
            <div class="wc-audio-hero-artwork">
                {{#if feature_image}}
                    <img src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{else}}
                    <img src="{{asset "images/Show_Cover-Wonder-Cabinet.png"}}" alt="Wonder Cabinet">
                {{/if}}
            </div>

            {{!-- Episode info and player --}}
            <div class="wc-audio-hero-content">
                <span class="wc-audio-hero-date">{{date published_at format="DD MMM YYYY"}}</span>
                <h1 class="wc-audio-hero-title">{{title}}</h1>
                {{#if custom_excerpt}}
                    <p class="wc-audio-hero-subtitle">{{custom_excerpt}}</p>
                {{/if}}

                {{!-- Player controls with service icons --}}
                <div class="wc-audio-actions">
                    <button class="wc-audio-play" id="wc-play-btn" aria-label="Play episode">
                        <svg id="wc-play-icon" class="play-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M8 5v14l11-7z"/>
                        </svg>
                        <svg id="wc-pause-icon" class="pause-icon" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
                            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                        </svg>
                    </button>

                    {{!-- Service icons, routed per brand (#107). Luminous has its own show
                         feeds; it has no dedicated pod.link, so that icon is simply absent
                         there rather than pointing at Wonder Cabinet's. Social accounts are
                         Wonder Cabinet Productions' and stay shared — see the footer. --}}
                    {{#has tag="luminous"}}
                        {{> "components/service-icons"
                            apple=@custom.luminous_apple_podcasts_link
                            spotify=@custom.luminous_spotify_link
                            youtube=@custom.luminous_youtube_music_link}}
                    {{else}}
                        {{> "components/service-icons"
                            apple=@custom.apple_podcasts_link
                            spotify=@custom.spotify_link
                            youtube=@custom.youtube_music_link
                            podlink=@custom.pod_link}}
                    {{/has}}
                </div>
            </div>
        </div>

        {{!-- Waveform section --}}
        <div class="wc-audio-waveform-section gh-inner">
            <div id="wc-waveform" class="wc-audio-waveform" tabindex="0" role="slider"
                 aria-label="Episode progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            <span class="wc-audio-time" id="wc-time-display" role="timer" aria-label="Playback time">0:00 / 0:00</span>
        </div>
    </section>
</section>
